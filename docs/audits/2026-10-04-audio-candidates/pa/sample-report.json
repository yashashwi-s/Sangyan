      "sha256": "6d16aa4898c1c7aede4160004ab60a037c6cf6e30c17dc7a04eda7d1fb4e8dff"
    },
    "helpScopeText": {
      "textHash": "5f6c3f5a2fbaa5866ab3f1c7bb0963f744f49a33d9d2003ad356b3f0da84264e",
      "spoken": "ਇਹ ਕਾਰਵਾਈ ਜੀਵਿਤ ਧਾਰਕ ਦੀ ਨਾਮਜ਼ਦਗੀ ਲਈ ਹੈ। ਮੌਤ ਹੋ ਚੁੱਕੀ ਹੋਵੇ ਤਾਂ ਸੰਸਥਾ ਤੋਂ ਮ੍ਰਿਤ ਧਾਰਕ ਦੇ ਦਾਅਵੇ ਜਾਂ ਸੰਪਤੀ ਤਬਾਦਲੇ ਦੀ ਕਾਰਵਾਈ ਪੁੱਛੋ। ਉਸ ਵੱਲੋਂ ਨਵੀਂ ਨਾਮਜ਼ਦਗੀ ਸ਼ੁਰੂ ਨਾ ਕਰੋ।",
      "bytes": 54114,
      "seconds": 13.383,
      "sha256": "b000d4d2e853a08eb420d879ff956db9fdc9bcc5912d8a18b36005874eceebaf"
    },
    "passwordHelp": {
      "textHash": "50fda26206dde08160bada320f56b40c60e3fb4949b5c372361ca10aa680a7b2",
      "spoken": "ਘੱਟੋ-ਘੱਟ ਬਾਰਾਂ ਅੱਖਰ। ਸੁਰੱਖਿਅਤ ਰੱਖੋ; ਅਸੀਂ ਮੁੜ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕਰ ਸਕਦੇ।",
      "bytes": 24449,
