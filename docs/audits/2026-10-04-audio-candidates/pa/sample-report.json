    "homeTitle": {
      "textHash": "9a91c6e13dc57e4abc753de9ca04cff46511de3c19c47d5d7518402e20aa3f72",
      "spoken": "ਆਪਣੇ ਪਰਿਵਾਰ ਦੇ ਖਾਤੇ ਲੱਭਣੇ ਸੌਖੇ ਬਣਾਓ।",
      "bytes": 12062,
      "seconds": 2.859,
      "sha256": "d935a41279d71e4a217735de595e6cc5507c756d5174e1aa3eb0c1913312b7be"
    },
    "nomineeExplain": {
      "textHash": "5be94723c1c6acb3bd74c33f9a578ad7bcadc5d17ef255a46e7d43fd1632effd",
      "spoken": "ਨਾਮਜ਼ਦ ਵਿਅਕਤੀ ਉਹ ਹੈ ਜਿਸ ਤੋਂ ਖਾਤਾਧਾਰਕ ਦੀ ਮੌਤ ਮਗਰੋਂ ਸੰਸਥਾ ਦਾਅਵਾ ਲੈ ਸਕਦੀ ਹੈ। ਨਾਮਜ਼ਦਗੀ ਕਾਰਵਾਈ ਵਿੱਚ ਮਦਦ ਕਰਦੀ ਹੈ; ਇਹ ਕਾਨੂੰਨੀ ਵਾਰਸ ਤੈਅ ਨਹੀਂ ਕਰਦੀ। ਜਾਂਚ ਨਾ ਕੀਤੀ ਹੋਵੇ ਤਾਂ “ਪੱਕਾ ਨਹੀਂ” ਚੁਣੋ।",
      "bytes": 60259,
      "seconds": 14.912,
      "sha256": "42a820fc9e995576ed9971857f8230d8dd05cc06526a193661adfdb7dba412a5"
    },
    "receiptExample": {
      "textHash": "5148109f138a5f4d71e3073e94dfcf2b5ae5fbdc9b2ed5e8c92f2ea464e5554b",
      "spoken": "“ਤੁਹਾਡੀ ਬੇਨਤੀ ਮਿਲ ਗਈ” ਦਾ ਅਰਥ ਬੇਨਤੀ ਹਾਲੇ ਲੰਬਿਤ ਹੈ।",
      "bytes": 15139,
      "seconds": 3.642,
      "sha256": "3924f5728526f7818d067b463a78777d345f57cb00d294a8942af767634b2835"
    },
    "registeredExample": {
